# Copy this file to airflow/.env and fill in local values.
AIRFLOW_UID=50000
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME

# HR pipeline SQL Server connection (configure for your own machine)
SQL_SERVER=host.docker.internal\\SQLEXPRESS
SQL_DATABASE=indus_weave
ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_USER=REPLACE_WITH_SQL_LOGIN
SQL_PASSWORD=REPLACE_WITH_SQL_PASSWORD
